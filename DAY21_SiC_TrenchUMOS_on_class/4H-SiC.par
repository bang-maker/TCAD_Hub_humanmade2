		#gamma		=	0.0,	0.0
		#delta		=	1.0,	1.0	 #4H-SiC [14Niw]		
				
										
		#a		=	0.1    , 4.828e6 #4H-SiC [97Kon], for hole, adjusted to OkutoCrowell model(E//c-axis)
		#b		=	6.346e6, 1.334e7 #4H-SiC [97Kon], for hole, adjusted to OkutoCrowell model(E//c-axis)
		#c		=	0.0,	0.0
		#d		=	0.0,	0.0
		#gamma		=	1,	0.0
		#delta		=	2,	1.0
				
						
	}

OkutoCrowell_aniso                     #parallel to c-axis
	{
                                        
		a		=	8.19e9 ,	4.51e6  #4H-SiC [14Niw] at 300K (E//c-axis)
		b		=	3.94e7 , 1.28e7  #4H-SiC [14Niw] at 300K (E//c-axis)
		c		=	0.0,	7.511e-3 #4H-SiC [14Niw]		
		d		=	0.0,	1.381e-3 #4H-SiC [14Niw]		
		gamma		=	0.0,	0.0
		delta		=	1.0,	1.0	 #4H-SiC [14Niw]		
				
										
		#a		=	0.1    , 4.828e6 #4H-SiC [97Kon], for hole, adjusted to OkutoCrowell model(E//c-axis)
		#b		=	6.346e6, 1.334e7 #4H-SiC [97Kon], for hole, adjusted to OkutoCrowell model(E//c-axis)
		#c		=	0.0,	0.0
		#d		=	0.0,	0.0
		#gamma		=	1,	0.0
		#delta		=	2,	1.0
				
		}


Auger
	{
		A		=	5e-31,	2e-31	#4H-SiC [97Gal]
	       #A		=	3e-29,	3e-29	   #6H-SiC [98Ram]
		B		=	0.0,	0.0	#to disable temp.dep.
		C		=	0.0,	0.0	#to disable temp.dep.
		H		=	0.0,	0.0
		N0		=	1.0e+18,1.0e+18
	}

NegInterfaceChargeMobility
{ *
  *         mu1 * (T/300)^T_exp * [1 + c/(c_trans*(NA,D/1e18)^N_exp1* (Nc/N0)^Nc_exp1)]^c_exp
  * mu_ic = ---------------------------------------------------------------
  *                           [Nc/N0]^Nc_exp2 * D * f(En)
  *
  * Nc    = negative interface charge density
  * N0    = 1e11/cm^2
  * c     = n (for electrons) , p (for holes)
  * f(En) = 1 - exp[-(En/E0)^En_exp]
  * D     = exp[-dist/l_crit]
  * dist  = distance from interface
  *
	mu1	= 40 ,	40	# [cm^2/Vs]
	T_exp	= 1  ,	1	# [1]
	c_trans	= 1.09e18 ,	1.0000e+18	# [cm^(-3)]
	c_exp	= 1.5 ,	1.5	# [1] 1.5
	Nc_exp1	= 1 ,	1	# [1] 1
	Nc_exp2	= 0.5 ,	0.5	# [1] 0.5
	l_crit	= 1.0000e-06 ,	1.0000e-06	# [cm]
	E0	= 2.0000e+05 ,	2.0000e+05	# [V/cm]
	En_exp	= 2 ,	2	# [1]
        N_exp1  = 0.528, 0

}

